# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/studyai

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_REMEMBER=30d

# Uploads
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200

# Optional: real AI provider (leave blank to use the built-in extractive engine)
AI_PROVIDER=
AI_API_KEY=
